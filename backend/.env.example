PORT=5000
FRONTEND_URL=http://localhost:5173
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_NAME=velosync
DB_PORT=5432
DB_POOL_MAX=10
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
# Testing only: returns the generated OTP in the signup API response. Keep false in production.
SHOW_TEST_OTP=false
# SMTP provider credentials. For Gmail, use an App Password, not your normal password.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASSWORD=your_ethereal_password
SMTP_FROM="VeloSync <mpastecs@gmail.com>"
